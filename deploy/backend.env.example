NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=loopback
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=akeem
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_NAME=akeem
DB_SYNC=false
DB_LOGGING=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
FRONTEND_URLS=https://app.example.com
FRONTEND_APP_URL=https://app.example.com
OPENAI_API_KEY=REPLACE_WITH_PROVIDER_KEY
OPENAI_MODEL=gpt-4.1-mini
EMAIL_DELIVERY_ENABLED=true
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=REPLACE_WITH_EMAIL_PROVIDER_KEY
EMAIL_FROM="AKEEM <noreply@example.com>"
EMAIL_TIMEOUT_MS=10000
FILE_STORAGE_DIR=/var/lib/akeem/uploads
FILE_MAX_SIZE_BYTES=10485760
MALWARE_SCAN_REQUIRED=false
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_TIMEOUT_MS=60000
AI_REQUEST_TIMEOUT_MS=60000
AI_PROVIDER_RETRY_LIMIT=2
AI_CHAT_TIMEOUT_MS=600000
REQUEST_TIMEOUT_MS=120000
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_POLL_INTERVAL_MS=2000

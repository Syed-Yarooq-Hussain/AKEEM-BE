PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=your-postgres-user
DB_PASSWORD=your-postgres-password
DB_NAME=your-postgres-database
DB_SYNC=false
DB_LOGGING=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URLS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:4200
FRONTEND_APP_URL=http://localhost:5173
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
# Optional per-agent model overrides (all fall back to OPENAI_MODEL)
OPENAI_ORCHESTRATOR_MODEL=gpt-4.1-mini
OPENAI_CEO_MODEL=gpt-4.1-mini
OPENAI_EXECUTIVE_MODEL=gpt-4.1-mini
OPENAI_SALES_MODEL=gpt-4.1-mini
OPENAI_FINANCE_MODEL=gpt-4.1-mini
OPENAI_MARKETING_MODEL=gpt-4.1-mini
OPENAI_LEGAL_MODEL=gpt-4.1-mini
OPENAI_OPERATIONS_MODEL=gpt-4.1-mini
OPENAI_CUSTOMER_SUCCESS_MODEL=gpt-4.1-mini
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-secret
QA_EMAIL=codex.qa@example.com
QA_PASSWORD=QaPassword123!
QA_ORGANIZATION_NAME=AKEEM QA
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=re_your-provider-key
EMAIL_FROM=AKEEM <noreply@example.com>
